# Optional: Gemini AI. Leave blank to use local deterministic fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Firebase Firestore. Leave disabled for local demo mode.
FIRESTORE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# Backend settings
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=25

# Frontend can leave this empty because Vite proxies /api to FastAPI.
VITE_API_BASE_URL=
